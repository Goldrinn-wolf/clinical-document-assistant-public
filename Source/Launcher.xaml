<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="临床文书助手 · 四合一 v1.4.1-public" Width="980" Height="750" MinWidth="760" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F3F6F8" FontFamily="Microsoft YaHei, Segoe UI" FontSize="14">
 <Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#244958"/><Setter Property="BorderBrush" Value="#D7E2E7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="8"/><Setter Property="Padding" Value="20"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E9F5F3"/><Setter TargetName="b" Property="BorderBrush" Value="#10837D"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#10837D"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="8,0,0,22"><TextBlock Text="离线临床文书工具" Foreground="#10837D" FontSize="13" Margin="0,0,0,10"/><TextBlock Text="临床文书助手" FontSize="32" FontWeight="Bold" Foreground="#153D49"/><WrapPanel><Button x:Name="ExaminationButton" Content="辅助检查 · 手动勾选  →" HorizontalAlignment="Left" Margin="0,8,12,0" Padding="9"/><Button x:Name="SmartLabButton" Content="检验智能整理 · 离线  →" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9"/></WrapPanel><TextBlock Text="四个工具，一个入口" FontSize="16" Foreground="#728994" Margin="0,8,0,0"/></StackPanel>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
 <Button x:Name="Entry0" AutomationProperties.Name="打开出院带药助手"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="01  ·  用药" Foreground="#10837D" FontSize="13"/><TextBlock Text="出院带药助手" FontSize="24" FontWeight="Bold" Margin="0,13,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="选择药物与模块，生成出院带药。&#10;保留已有自定义药物和模块功能。" TextWrapping="Wrap" FontSize="13" Foreground="#728994" Margin="0,10,0,8"/><TextBlock Grid.Row="2" Text="进入带药助手  →" Foreground="#10837D" FontWeight="Bold"/></Grid></Button>
 <Button x:Name="Entry1" Grid.Column="1" AutomationProperties.Name="打开出院医嘱助手"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="02  ·  出院" Foreground="#10837D" FontSize="13"/><TextBlock Text="出院医嘱助手" FontSize="24" FontWeight="Bold" Margin="0,13,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="按步骤选择疾病、复诊及其他医嘱。&#10;自定义条目可添加、修改和删除。" TextWrapping="Wrap" FontSize="13" Foreground="#728994" Margin="0,10,0,8"/><TextBlock Grid.Row="2" Text="进入医嘱助手  →" Foreground="#10837D" FontWeight="Bold"/></Grid></Button>
 <Button x:Name="Entry2" Grid.Row="1" AutomationProperties.Name="打开入院首程助手"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="03  ·  入院" Foreground="#10837D" FontSize="13"/><TextBlock Text="入院首程助手" FontSize="24" FontWeight="Bold" Margin="0,13,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="诊断依据、鉴别诊断与诊疗计划。&#10;13类计划 · 共病及治疗按需勾选。" TextWrapping="Wrap" FontSize="13" Foreground="#728994" Margin="0,10,0,8"/><TextBlock Grid.Row="2" Text="进入首程助手  →" Foreground="#10837D" FontWeight="Bold"/></Grid></Button>
 <Button x:Name="Entry3" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="打开日常病程助手"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="04  ·  病程" Foreground="#10837D" FontSize="13"/><TextBlock Text="日常病程助手" FontSize="24" FontWeight="Bold" Margin="0,13,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="查房、术后、出院及特殊记录。&#10;自定义检查、记录模块和处理参考。" TextWrapping="Wrap" FontSize="13" Foreground="#728994" Margin="0,10,0,8"/><TextBlock Grid.Row="2" Text="进入病程助手  →" Foreground="#10837D" FontWeight="Bold"/></Grid></Button>
 </Grid><TextBlock x:Name="Status" Grid.Row="2" Text="点击入口打开对应工具 · 各工具沿用已有本机草稿与自定义库" Foreground="#728994" Margin="8,18,8,0" TextWrapping="Wrap"/>
 </Grid>
</Window>
