<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="日常病程助手 · 公开版" Width="1340" Height="860" MinWidth="860" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F3F6F8" FontFamily="Microsoft YaHei, Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#244958"/><Setter Property="BorderBrush" Value="#D7E2E7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="4,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#13847F"/><Setter TargetName="border" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="BorderBrush" Value="#D7E2E7"/><Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="#213F4A"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#DBEFEE"/><Setter Property="Foreground" Value="#08746F"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#A3CDC9"/><Setter TargetName="b" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="22,16,22,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="离线临床文书工具" FontSize="13" Foreground="#10837D" Margin="0,0,0,5"/><TextBlock Text="日常病程助手" FontSize="26" FontWeight="Bold" Foreground="#153D49"/><TextBlock x:Name="CaseSummary" Text="模块分别保存 · 当前患者共用辅助检查与处理" Foreground="#68838D" Margin="0,5,0,0"/></StackPanel><WrapPanel Grid.Column="1" MaxWidth="430" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="CustomButton" Content="自定义项目" Margin="4,3"/><Button x:Name="ExamsButton" Content="辅助检查" Margin="4,3"/><Button x:Name="SmartLabButton" Content="检验智能整理" Margin="4,3"/><Button x:Name="HandlingButton" Content="异常处理" Margin="4,3"/><Button x:Name="HelpButton" Content="使用说明" Margin="4,3"/></WrapPanel></Grid>
  <Grid x:Name="Body" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="435"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
   <Border x:Name="ModulesPanel" Background="White" CornerRadius="10" Padding="12" Margin="0,0,14,0" BorderBrush="#E0E8EC" BorderThickness="1"><DockPanel><TextBlock Text="病程模块" FontWeight="Bold" Foreground="#254C59" Margin="5,3,0,12" DockPanel.Dock="Top"/><TextBlock Text="括号项双击修改&#10;输入框空白回退默认&#10;检查和处理按患者共用" Foreground="#728994" FontSize="12" Margin="5,12,0,0" TextWrapping="Wrap" DockPanel.Dock="Bottom"/><ListBox x:Name="ModuleList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></DockPanel></Border>
   <Border x:Name="FormPanel" Grid.Column="1" Background="White" CornerRadius="10" Padding="16" BorderBrush="#E0E8EC" BorderThickness="1"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"><TextBlock x:Name="ModuleTitle" FontSize="19" FontWeight="Bold" Foreground="#254C59" TextWrapping="Wrap"/><TextBlock x:Name="ModuleHint" Text="填写可变内容，固定句沿用模板" Foreground="#728994" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/><UniformGrid x:Name="SpecialButtons" Columns="2" Visibility="Collapsed" Margin="0,10,0,0"><Button x:Name="LumbarButton" Content="腰椎穿刺" Margin="0,0,5,0"/><Button x:Name="ThrombolysisButton" Content="溶栓记录" Margin="5,0,0,0"/></UniformGrid></StackPanel><ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="FormContent"/></ScrollViewer></DockPanel></Border>
   <Border x:Name="PreviewPanel" Grid.Column="3" Background="White" CornerRadius="10" Padding="16" BorderBrush="#E0E8EC" BorderThickness="1"><DockPanel><StackPanel DockPanel.Dock="Top"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="病程文本" FontSize="19" FontWeight="Bold" Foreground="#254C59"/><TextBlock x:Name="PreviewState" Text="填写后点击生成" Foreground="#728994" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="SmallerButton" Content="A−" Padding="8,5"/><Button x:Name="LargerButton" Content="A+" Padding="8,5"/></StackPanel></Grid><TextBlock x:Name="PreviewHint" Text="只改你标注的字段，固定文本保留原文。" Foreground="#728994" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,9"/></StackPanel><UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0"><Button x:Name="CopyButton" Content="复制全文" Margin="0,0,5,0" Background="#E8F3F2" BorderThickness="0"/><Button x:Name="ExportButton" Content="导出 TXT" Margin="5,0,0,0"/></UniformGrid><TextBox x:Name="PreviewBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15" Padding="10" Background="#FAFCFD" BorderBrush="#E8EEF1" VerticalContentAlignment="Top" AutomationProperties.Name="生成的病程文本"/></DockPanel></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="先选择记录模块 · 当前患者草稿自动保存" Foreground="#728994" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="NewButton" Content="新患者"/><Button x:Name="GenerateButton" Content="生成病程  Ctrl+Enter" Background="#10837D" Foreground="White" BorderThickness="0" Padding="20,12"/></StackPanel></Grid>
 </Grid>
</Window>
